@startuml
title 学級日誌システム クラス図

skinparam defaultFontName "Noto Sans CJK JP"
skinparam classFontName "Noto Sans CJK JP"
skinparam classAttributeFontName "Noto Sans CJK JP"
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
skinparam nodesep 100
skinparam ranksep 90
skinparam linetype ortho

hide circle
left to right direction

class "学生" as Student {
  - 氏名: string
  - 所属: string
  - 役割: string
  --
  + 日誌を受け取る()
  + 日誌を記入する()
  + 日誌を提出する()
}

class "教師" as Teacher {
  - 氏名: string
  - 役割: string
  --
  + 所感を記入する()
  + 押印する()
  + 日誌を保管する()
}

class "学級日誌" as Diary {
  - 日付: date
  - 対象クラス: string
  - 記入者: string
  - 所感: string
  - 押印済み: boolean
  - 状態: string
  --
  + 記入する()
  + 提出する()
  + 保管する()
}

Student --> Student : 引き継ぎ
Student --> Diary : 記入・提出
Teacher --> Diary : 所感記入・押印・保管

@enduml